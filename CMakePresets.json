{
    "version": 8,
    "configurePresets": [
        {
            "name": "Visual Studio 2026",
            "displayName": "Visual Studio Community 2026 Release - x86_amd64",
            "description": "Using compilers for Visual Studio 18 2026 (x86_x64 architecture)",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x86",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "Clang 22.1.5 x86_64-pc-linux-gnu",
            "displayName": "Clang 22.1.5 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/_install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Visual Studio 2026-debug",
            "displayName": "Visual Studio Community 2026 Release - x86_amd64 - Debug",
            "configurePreset": "Visual Studio 2026",
            "configuration": "Debug"
        }
    ]
}